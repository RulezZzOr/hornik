#!/bin/sh
set -eu

REPORT_PATH=${OPENMINEROS_SELF_TEST_REPORT:-/var/log/openmineros/safe-self-test.txt}
mkdir -p "$(dirname "$REPORT_PATH")"

api_get() {
    path="$1"
    if command -v curl >/dev/null 2>&1; then
        curl -fsS "http://127.0.0.1:8080$path"
    elif command -v wget >/dev/null 2>&1; then
        wget -qO- "http://127.0.0.1:8080$path"
    else
        echo "curl/wget missing" >&2
        return 127
    fi
}

check_file_flag() {
    pattern="$1"
    file="$2"
    if grep -Eq "$pattern" "$file"; then
        echo "PASS $file $pattern"
        return 0
    fi
    echo "FAIL $file missing $pattern"
    return 1
}

check_json_bool() {
    key="$1"
    value="$2"
    file="$3"
    if grep -Eq "\"$key\"[[:space:]]*:[[:space:]]*$value" "$file"; then
        echo "PASS $key=$value"
        return 0
    fi
    echo "FAIL $key expected $value"
    return 1
}

tmp_dir="$(mktemp -d /tmp/openmineros-safe-self-test.XXXXXX)"
trap 'rm -rf "$tmp_dir"' EXIT INT TERM
failed=0

{
    echo "OpenMinerOS safe first-boot self-test"
    echo "generated_utc=$(date -u '+%Y-%m-%dT%H:%M:%SZ' 2>/dev/null || true)"
    echo

    echo "[runtime_env]"
    cat /etc/openmineros/runtime.env 2>/dev/null || true
    echo

    echo "[release]"
    cat /etc/openmineros/release.json 2>/dev/null || true
    echo

    echo "[anti_brick]"
    if api_get /api/v1/firmware/anti-brick > "$tmp_dir/anti-brick.json"; then
        cat "$tmp_dir/anti-brick.json"
    else
        echo "FAIL anti-brick API unavailable"
        failed=1
    fi
    echo

    echo "[readiness]"
    api_get /api/v1/hardware/readiness 2>/dev/null || true
    echo

    echo "[ssh]"
    if /usr/bin/openmineros-ssh-check; then
        :
    else
        failed=1
    fi
    echo

    echo "[checks]"
    check_file_flag '^OPENMINEROS_BACKEND=hardware-probe$' /etc/openmineros/runtime.env || failed=1
    check_file_flag '^OPENMINEROS_FIRST_BOOT_SAFE=1$' /etc/openmineros/runtime.env || failed=1
    check_file_flag '^OPENMINEROS_DISABLE_NAND_WRITES=1$' /etc/openmineros/runtime.env || failed=1
    check_file_flag '^OPENMINEROS_DISABLE_ASIC_WRITES=1$' /etc/openmineros/runtime.env || failed=1
    check_file_flag '^OPENMINEROS_ALLOW_UNSAFE_HARDWARE=0$' /etc/openmineros/runtime.env || failed=1

    if [ -f "$tmp_dir/anti-brick.json" ]; then
        check_json_bool safe_to_first_boot true "$tmp_dir/anti-brick.json" || failed=1
        check_json_bool nand_writes_allowed false "$tmp_dir/anti-brick.json" || failed=1
        check_json_bool asic_writes_allowed false "$tmp_dir/anti-brick.json" || failed=1
        check_json_bool flashing_allowed false "$tmp_dir/anti-brick.json" || failed=1
    fi

    echo
    if [ "$failed" -eq 0 ]; then
        echo "RESULT pass"
    else
        echo "RESULT fail"
    fi
} > "$REPORT_PATH"

cat "$REPORT_PATH"

if [ "$failed" -ne 0 ]; then
    exit 1
fi
